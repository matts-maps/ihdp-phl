---
import LayerCard from './LayerCard.astro';

interface Layer {
	id: string;
	name: string;
	description: string;
	category: string;
	geometryType: string;
	featureCount?: string | number;
	lastUpdated: string;
	downloadStatus: 'pending' | 'available';
}

interface Props {
	layers: Layer[];
}

const { layers } = Astro.props;
---

<div class="not-content grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
	{layers.map((layer) => <LayerCard {...layer} />)}
</div>
